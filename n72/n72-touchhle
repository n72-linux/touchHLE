#!/bin/sh
# n72-touchhle APP: an iPhone OS app (.app or .ipa) in the native touchHLE
# fork, as the launcher starts it. Log: /root/n72hle-test/<app>.log
# Installed as /usr/bin/n72-touchhle (by hand; no package owns it).
# --print-fps writes the frame rate to the log once a second.
cd /root/n72hle-test || exit 1
log=/root/n72hle-test/$(basename "${1%.*}").log
# Optional per-app environment (debug switches for one game), sourced if it
# exists: /root/n72hle-test/<app>.env with "export NAME=value" lines.
env=/root/n72hle-test/$(basename "${1%.*}").env
[ -f "$env" ] && . "$env"
echo "=== start $(date) $1${N72_ENV_NOTE:+ [$N72_ENV_NOTE]}" >> "$log"
SDL_VIDEODRIVER=kmsdrm RUST_BACKTRACE=1 ./touchHLE "$1" --print-fps >> "$log" 2>&1
echo "=== exit $? $(date)" >> "$log"
